<?xml version="1.0" encoding="UTF-8"?>
<zk>
<zscript>
    import org.compiere.model.MSysConfig;
    import org.compiere.util.Env;
    import org.compiere.util.Msg;
    import org.compiere.util.Util;
    var msgText = "";
    var msgValue = MSysConfig.getValue(MSysConfig.ZK_DESKTOP_HEADER_MESSAGE_VALUE);
    if (!Util.isEmpty(msgValue, true))
        msgText = Msg.getMsg(Env.getCtx(), msgValue);
</zscript>
<!-- HeaderPanel replaces inline image styles, so keep this constraint with the ZUL. -->
<html><![CDATA[
<style>
.desktop-header-left,
.desktop-header-left > tbody > tr,
.desktop-header-left > tbody > tr > td {
    height: 44px !important;
    max-height: 44px !important;
}

.desktop-header-logo {
    display: block !important;
    width: auto !important;
    height: 30px !important;
    max-width: 160px !important;
    max-height: 30px !important;
    object-fit: contain !important;
}
</style>
]]></html>
<div sclass="desktop-header" use="org.adempiere.webui.panel.HeaderPanel" id="header">
    <hbox vflex="1" hflex="1" align="center">
        <hbox height="100%" pack="start" align="center" sclass="desktop-header-left" hflex="1">
            <image id="logo" src="~./theme/slerptech/images/header-logo.png" sclass="desktop-header-logo"/>
            <div id="menuLookup"/>
            <button id="menuButton" sclass="btn-small"/>
            <span class="systemStatus">${msgText}</span>
        </hbox>
        <vbox hflex="min" apply="org.adempiere.webui.panel.UserPanel" align="end" sclass="desktop-user-panel">
            <vbox align="end">
                <label use="org.adempiere.webui.component.Label" id="loginUserAndRole" style="cursor: pointer;" sclass="desktop-header-font desktop-header-username"/>
                <hbox align="center" id="userPanelLinksContainer" hflex="min">
                    <toolbarbutton use="org.adempiere.webui.component.ToolBarButton" sclass="desktop-header-font link" id="feedback"/>
                    <separator orient="vertical" bar="true" height="13px"/>
                    <toolbarbutton use="org.adempiere.webui.component.ToolBarButton" sclass="desktop-header-font link" id="preference"/>
                    <separator orient="vertical" bar="true" height="13px"/>
                    <toolbarbutton use="org.adempiere.webui.component.ToolBarButton" sclass="desktop-header-font link" id="changeRole"/>
                    <separator orient="vertical" bar="true" height="13px"/>
                    <toolbarbutton use="org.adempiere.webui.component.ToolBarButton" sclass="desktop-header-font link" id="logout"/>
                </hbox>
            </vbox>
        </vbox>
    </hbox>
</div>
</zk>
